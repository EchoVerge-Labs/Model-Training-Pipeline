# ── DagsHub (DVC remote + MLflow) ──
DAGSHUB_USER=dagshub_your_username
DAGSHUB_TOKEN=dagshub_your_token

# ── Google Sheets API (catalog snapshot) ──
GOOGLE_SHEET_ID=your_id
GOOGLE_CLIENT_SECRET_JSON=/path/to/client_secret.json
# Optional: cached OAuth token location (default shown)
# GOOGLE_AUTH_USER_JSON=~/.config/gspread/authorized_user.json

# ── HuggingFace (model downloads) ──
HF_TOKEN=hf_your_token

# ── Multi-node training ──
MASTER_ADDR=10.8.100.40
MASTER_PORT=29500
NNODES=1
NODE_RANK=0
